# ========================================
# Claude Chat System - Environment Variables
# ========================================
# Copy this file to .env.local and fill in your actual values

# ========================================
# Anthropic Claude API
# ========================================
# Get your API key from: https://console.anthropic.com/
# This key is used by the backend server to communicate with Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ========================================
# Supabase Configuration
# ========================================
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anonymous/public key (safe for client-side use)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ========================================
# Server Configuration
# ========================================
# Port for the Express backend server (optional, defaults to 3001)
PORT=3001

# Personal calendar URL for dashboard widget (optional)
VITE_CALENDAR_URL=https://calendar.google.com

# Google Calendar read settings (existing right-panel event list)
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key_here
GOOGLE_CALENDAR_ID=your_calendar_id_here

# Google OAuth settings (required for direct "Save to Calendar" from app)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/calendar/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5173/calendar

# Optional: protects /api/dev/interventions/trigger in development
# If set, send header x-dev-token with the same value
DEV_INTERVENTION_TOKEN=your_optional_dev_token_here

# ========================================
# Setup Instructions:
# ========================================
#
# 1. Anthropic API Key:
#    - Sign up at https://console.anthropic.com/
#    - Navigate to API Keys section
#    - Create a new API key
#    - Copy the key and paste it as ANTHROPIC_API_KEY value
#
# 2. Supabase Setup:
#    - Sign up at https://supabase.com/
#    - Create a new project
#    - Go to Project Settings > API
#    - Copy the Project URL to VITE_SUPABASE_URL
#    - Copy the anon/public key to VITE_SUPABASE_ANON_KEY
#    - Run the SQL schema from supabase-schema.sql in your Supabase SQL editor
#
# 3. Save this file as .env.local (it's already in .gitignore)
#
# ========================================
